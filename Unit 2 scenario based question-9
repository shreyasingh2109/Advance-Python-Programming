# 0/1 Knapsack Problem using Dynamic Programming

def knapsack(weights, values, capacity):
    n = len(weights)

    # dp[i][w] stores the maximum value that can be obtained
    # using the first i items with capacity w
    dp = [[0 for _ in range(capacity + 1)] for _ in range(n + 1)]

    # Build the DP table
    for i in range(1, n + 1):
        for w in range(1, capacity + 1):

            # If the current item's weight can fit
            if weights[i - 1] <= w:
                dp[i][w] = max(
                    values[i - 1] + dp[i - 1][w - weights[i - 1]],
                    dp[i - 1][w]
                )
            else:
                # Cannot include the current item
                dp[i][w] = dp[i - 1][w]

    return dp[n][capacity]


# Accept item weights and values
weights = list(map(int, input("Enter item weights: ").split()))
values = list(map(int, input("Enter item values: ").split()))

# Check that weights and values have the same number of items
if len(weights) != len(values):
    print("Error: Number of weights and values must be the same.")
else:
    # Accept bag capacity
    capacity = int(input("Enter bag capacity: "))

    # Calculate maximum obtainable value
    max_value = knapsack(weights, values, capacity)

    # Display result
    print("Maximum obtainable value:", max_value)
