# Coin Change Problem using Dynamic Programming

def coin_change(coins, amount):
    # dp[i] stores the minimum number of coins needed
    # to make the amount i
    dp = [float('inf')] * (amount + 1)

    # Base case: 0 coins are needed to make amount 0
    dp[0] = 0

    # Calculate minimum coins for each amount
    for i in range(1, amount + 1):
        for coin in coins:
            if coin <= i:
                dp[i] = min(dp[i], dp[i - coin] + 1)

    # If amount cannot be formed
    if dp[amount] == float('inf'):
        return -1

    return dp[amount]


# Accept coin denominations from the user
coins = list(map(int, input("Enter coin denominations: ").split()))

# Accept target amount
amount = int(input("Enter target amount: "))

# Find minimum number of coins
result = coin_change(coins, amount)

# Display result
if result == -1:
    print("The target amount cannot be formed using the given coins.")
else:
    print("Minimum number of coins required:", result)
